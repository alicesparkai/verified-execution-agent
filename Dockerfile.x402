# VEA на ОФИЦИАЛЬНОМ платёжном стеке OKX x402 — ОТДЕЛЬНЫЙ сервис.
#
# ЗАЧЕМ ОТДЕЛЬНЫЙ ФАЙЛ, А НЕ ПРАВКА Dockerfile:
#   основной Dockerfile собирает ЖИВОЙ сервис (ветка main), на который ссылается подача на
#   Hedera x402 Bounty (дедлайн 31.07). Менять его старт-команду — значит рискнуть чужой,
#   уже работающей подачей ради этой. Здесь другой вход (serverX402) и другая ветка.
#
# ОБЯЗАТЕЛЬНО в проде:
#   VEA_RELAYER_KEY   — приватный ключ ретранслятора (0x + 64 hex). Им фасилитатор ГАСИТ
#                       подписанное покупателем разрешение на X Layer. Без него сервер
#                       намеренно НЕ стартует: молча отдавать 402, который невозможно
#                       закрыть, хуже, чем упасть громко.
#   VEA_ATTESTOR_KEY  — содержимое attestor_key.json: закрепляет личность аттестора, иначе
#                       после передеплоя старые чеки перестанут проверяться.
# ЖЕЛАТЕЛЬНО:
#   VEA_RESOURCE      — публичный URL платного ресурса. Должен СОВПАДАТЬ с адресом, по
#                       которому стучится ревьюер, иначе resource в challenge не сойдётся.
#   VEA_PAY_TO        — получатель выручки (по умолчанию адрес из реестра).
#   VEA_XLAYER_RPC    — RPC X Layer, если дефолтный недоступен.
FROM node:20-slim
WORKDIR /app

COPY package*.json ./
RUN npm install --no-audit --no-fund

COPY . .

ENV PORT=8402
EXPOSE 8402

CMD ["npm", "run", "serve:x402"]
