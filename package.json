    "dashboard": "tsx src/buildDashboard.ts",
    "demo:full": "tsx src/demo.ts && tsx src/buildDashboard.ts",
    "serve": "tsx src/server.ts",
    "demo:agent": "tsx src/demoTrader.ts",
    "hedera:setup": "tsx src/hederaSetup.ts",
    "hedera:demo": "tsx src/hederaDemo.ts",
    "serve:x402": "tsx src/serverX402.ts"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.81.0",
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "express": "^5.2.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
